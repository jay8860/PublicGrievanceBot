# Copy this file to .env for local development (Railway/host: set these as
# real environment variables in the platform's dashboard instead — never
# commit a real .env file, it's already in .gitignore).

# --- Telegram Bot ---
# Get this from @BotFather on Telegram. Required — the bot will refuse to
# start without it.
TELEGRAM_BOT_TOKEN=

# --- Gemini (Google AI Studio) Vision API ---
# Get a key at https://aistudio.google.com/apikey. Either name works.
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# --- Google Sheets (used as the ticket database) ---
# Full JSON of a Google Cloud service account key, as a single-line string,
# shared as an Editor on the target Google Sheet. Do NOT commit the JSON
# key file itself anywhere in the repo.
GOOGLE_SHEETS_CREDENTIALS=

# --- Dashboard Admin Login ---
# Change these before deploying — the code falls back to weak defaults
# (admin/admin123) and logs a warning if these are unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_something_strong

# Secret used to sign dashboard JWT sessions. Set this to a long random
# string in production (e.g. `openssl rand -hex 32`).
SECRET_KEY=

# --- Officer Notifications ---
# Fallback Telegram chat ID to notify when a grievance category has no
# officer with a registered Telegram_Chat_ID in the "Officer Details" sheet
# yet. Leave unset to just skip notification (ticket is still logged).
DEFAULT_OFFICER_CHAT_ID=

# Kill switch for officer notifications (set to "false" to disable
# entirely, e.g. during a data-migration/testing window).
ENABLE_OFFICER_NOTIFICATIONS=true

# --- Dashboard API ---
# Comma-separated list of allowed origins for the dashboard API's CORS
# policy, e.g. "https://grievance.dhamtari.gov.in". Defaults to "*" (allow
# all) if unset, which is fine for a pilot but should be locked down before
# a public production rollout.
CORS_ORIGINS=

# Port the FastAPI/uvicorn server binds to. Most hosts (Railway etc.) set
# this automatically.
PORT=8000
