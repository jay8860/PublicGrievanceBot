# Copy this file to .env for local development (Railway/host: set these as
# real environment variables in the platform's dashboard instead — never
# commit a real .env file, it's already in .gitignore).

# --- Telegram Bot ---
# Get this from @BotFather on Telegram. Required — the bot will refuse to
# start without it.
TELEGRAM_BOT_TOKEN=

# --- OpenRouter (AI triage / vision) ---
# Get a key at https://openrouter.ai/keys. Replaces the old Gemini/Google AI
# Studio key: the photo is analysed through OpenRouter's chat-completions API.
OPENROUTER_API_KEY=
# Optional. Model used to analyse the grievance photo - it MUST accept images.
# Default: google/gemini-2.0-flash-001
# Other vision options: qwen/qwen2.5-vl-72b-instruct, openai/gpt-4o-mini
OPENROUTER_MODEL=
# Optional. Override the API base (only needed for a proxy/self-hosted gateway).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Google Sheets (used as the ticket database) ---
# Full JSON of a Google Cloud service account key, as a single-line string,
# shared as an Editor on the target Google Sheet. Do NOT commit the JSON
# key file itself anywhere in the repo.
GOOGLE_SHEETS_CREDENTIALS=

# --- Dashboard Admin Login ---
# Change these before deploying — the code falls back to weak defaults
# (admin/admin123) and logs a warning if these are unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_something_strong

# Secret used to sign dashboard JWT sessions. Set this to a long random
# string in production (e.g. `openssl rand -hex 32`).
SECRET_KEY=

# --- TEMPORARY LOGIN BYPASS (hide the login screen for now) ---
# Set to true to hide the dashboard login for the time being: the protected
# API routes stop requiring a JWT and the dashboard opens directly (the
# Login screen and all auth code stay in the codebase, just unused while
# this is on). The API logs a loud security warning at startup, and the
# dashboard shows a "LOGIN BYPASSED" badge so it can't be forgotten.
# Set back to false (or delete this line) and restart the API to restore
# the login screen exactly as it was.
BYPASS_LOGIN=false

# --- Platform database / automatic escalation (v2) ---
# PostgreSQL is the safest choice when you run more than one instance. With a
# Railway volume, SQLite on that volume is supported and simplest:
#   DATABASE_URL=sqlite:////data/grievance.db      (four slashes = absolute path)
# Without DATABASE_URL the app writes ./grievance.db inside the container,
# which is wiped on every redeploy.
DATABASE_URL=

# --- Persistent photo storage (Railway volume) ---
# Folder where before/after photos are archived. Attach a Railway volume and
# point this inside it, e.g. /data/media. Left empty, photos are kept only as
# Telegram file_ids, which break when the bot token is rotated. The folder is
# created on first save, and failures never block a complaint.
MEDIA_ROOT=
# Seconds between automatic TAT checks (default 300).
ESCALATION_TICK_SECONDS=300
# Set to false when running `python worker.py` as a separate service.
ENABLE_ESCALATION_SCHEDULER=true
# Mirror bot complaints into the platform database (false = Google Sheets only).
PLATFORM_DB_ENABLED=true
# Human-readable ticket prefix: GRV-2026-000001
TICKET_PREFIX=GRV
# Dashboard JWT lifetime in minutes (default 24 h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# AI-verified resolutions close themselves (status VERIFIED) and only fall back
# to the Resolution Verification queue when the photo check can't decide.
# Set to false to send every resolution to manual verification.
AUTO_APPROVE_AI_RESOLUTION=true

# --- Officer Notifications ---
# Fallback Telegram chat ID to notify when a grievance category has no
# officer with a registered Telegram_Chat_ID in the "Officer Details" sheet
# yet. Leave unset to just skip notification (ticket is still logged).
DEFAULT_OFFICER_CHAT_ID=

# Kill switch for officer notifications (set to "false" to disable
# entirely, e.g. during a data-migration/testing window).
ENABLE_OFFICER_NOTIFICATIONS=true

# --- Dashboard API ---
# Comma-separated list of allowed origins for the dashboard API's CORS
# policy, e.g. "https://grievance.dhamtari.gov.in". Defaults to "*" (allow
# all) if unset, which is fine for a pilot but should be locked down before
# a public production rollout.
CORS_ORIGINS=

# Port the FastAPI/uvicorn server binds to. Most hosts (Railway etc.) set
# this automatically.
PORT=8000
